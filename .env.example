# Spotify app (create at developer.spotify.com/dashboard)
# Redirect URI in the dashboard MUST be exactly:
#   http://127.0.0.1:3000/api/auth/callback
SPOTIFY_CLIENT_ID=

# One host everywhere. Use 127.0.0.1, not localhost — they are different
# origins to the browser, and mixing them drops the PKCE cookie.
NEXT_PUBLIC_BASE_URL=http://127.0.0.1:3000

# Music Metrics "Spotify Audio Features / Track Analysis" on RapidAPI
# (free tier) — replaces Spotify's deprecated audio-features endpoint.
# Subscribe to THIS specific API; a RapidAPI key alone is not enough.
RAPIDAPI_KEY=
